#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Rust
/rust/target/

# Gradle caches
**/.gradle/
android/.kotlin/

# Local backups
/Archiv.zip

# Claude
.claude/

# Guards for the old locations of the Libre 3 blobs + keys (now in vendor_keys/).
/android/app/src/main/jniLibs/**/*.so
/android/libre3.properties

# Dexcom G7, Omnipod DASH and FreeStyle Libre 3 keys + the Libre 3 blob: the
# manufacturers', never committed. Supplied locally per docs/VENDOR_KEYS.md.
/assets/vendor_keys/*
!/assets/vendor_keys/vendor_keys.example.json

# Android build output
/android/build/
