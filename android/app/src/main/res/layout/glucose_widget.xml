<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen glucose widget. Every value is pushed in by the read pipeline
     (GlucoseWidgetProvider); nothing here is populated from resources. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/glucose_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glucose_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glucose_widget_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/glucose_widget_muted"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/glucose_widget_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textColor="@color/glucose_widget_muted"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/glucose_widget_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/glucose_widget_muted"
            android:textSize="11sp" />

        <Chronometer
            android:id="@+id/glucose_widget_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/glucose_widget_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
